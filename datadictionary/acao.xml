<?xml version="1.0" encoding="ISO-8859-1"?>
<metadados xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../.gradle/metadados.xsd">
  <table name="AD_CONF_CARGA_ACAO" sequenceType="A" sequenceField="NUACAO">
    <description>Historico das decisoes administrativas da conferencia de cargas</description>
    <primaryKey><field name="NUACAO"/></primaryKey>
    <instances><instance name="AD_ConfCargaAcao"><description>Decisoes administrativas da conferencia</description></instance></instances>
    <fields>
      <field name="NUACAO" dataType="INTEIRO"><description>Identificador da decisao</description></field>
