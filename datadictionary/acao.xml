      <field name="ACAO" dataType="TEXTO" size="30"><description>VALIDAR, VALIDAR_DIVERGENTE ou RECONFERIR</description></field>
      <field name="STATUS_ANT" dataType="TEXTO" size="1"><description>Status anterior</description></field>
      <field name="STATUS_NOVO" dataType="TEXTO" size="1"><description>Status novo</description></field>
      <field name="CODUSU" dataType="INTEIRO"><description>Usuario da decisao</description></field>
      <field name="DHACAO" dataType="DATA_HORA"><description>Data e hora da decisao</description></field>
      <field name="JUSTIFICATIVA" dataType="TEXTO" size="500"><description>Motivo da decisao</description></field>
    </fields>
  </table>
</metadados>
